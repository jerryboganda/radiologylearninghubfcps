{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radbrain://schemas/classify/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "mappings"],
  "properties": {
    "intent": {"enum": ["explain", "compare", "differential", "show", "report", "quiz", "unknown"]},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["curriculum_code", "confidence", "reason"],
        "properties": {
          "curriculum_code": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
