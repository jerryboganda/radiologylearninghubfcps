{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radbrain://schemas/local/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "sentences"],
  "properties": {
    "status": {"enum": ["ok", "insufficient_context"]},
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citations"],
        "properties": {
          "text": {"type": "string"},
          "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
